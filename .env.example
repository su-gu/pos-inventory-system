# Copy to .env.local (gitignored) and fill with your Supabase project values.
# Vite only exposes vars prefixed with VITE_ to the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service-role key is server-side only and must NOT be exposed to the client.
# Do not add it here or to .env.local unless a Rust/server context legitimately needs it.
# SUPABASE_SERVICE_ROLE_KEY=
